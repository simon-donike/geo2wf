# Optional non-secret settings: copy to the repository root as .env.
# Set these to `id -u` and `id -g` on the Docker host before building.
LOCAL_UID=1000
LOCAL_GID=1000
RUNNER_CPUS=2
RUNNER_MEMORY=4g
STORMSENSE_WORKERS=2
STORMSENSE_IMAGERY_WORKERS=2
STORMSENSE_INTERVAL_SECONDS=900
STORMSENSE_PUBLISH=0
WEB_PORT=8080
WANDB_DISABLED=true
# Required only with compose.r2.yaml; the config is mounted, never copied.
# RCLONE_CONFIG_FILE=/absolute/path/to/rclone.conf
