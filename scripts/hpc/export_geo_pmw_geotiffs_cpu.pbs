#!/bin/bash
#PBS -N geoPmwExportCPU
#PBS -q cpu_std
#PBS -l walltime=06:00:00
#PBS -j eo
#PBS -l select=1:ncpus=16:mem=64gb

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR_DEFAULT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

if [[ -f "${REPO_DIR_DEFAULT}/.local.env" ]]; then
  set -a
  source "${REPO_DIR_DEFAULT}/.local.env"
  set +a
elif [[ -f "${REPO_DIR_DEFAULT}/.local.example.env" ]]; then
  set -a
  source "${REPO_DIR_DEFAULT}/.local.example.env"
  set +a
fi

REPO_DIR="${GEO2WF_REPO_DIR:-${REPO_DIR_DEFAULT}}"
CONFIG_FILE="${CONFIG_FILE:-${REPO_DIR}/configs/config_pretrain_geo_pmw.yaml}"
EXPORT_LIMIT="${EXPORT_LIMIT:-}"
EXPORT_SPLITS="${EXPORT_SPLITS:-train val test}"
EXPORT_UV_SYNC="${EXPORT_UV_SYNC:-false}"

cd "${REPO_DIR}"

export UV_PROJECT="${REPO_DIR}"
export UV_CACHE_DIR="${REPO_DIR}/.uv-cache"
export UV_PYTHON=3.11
export PYTHONUNBUFFERED=1
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export MPLCONFIGDIR="${TMPDIR:-/tmp}/dif-img-rec-matplotlib-${USER:-user}"
mkdir -p "${UV_CACHE_DIR}" "${MPLCONFIGDIR}"

if [[ "${EXPORT_UV_SYNC}" == "true" ]]; then
  uv sync --python 3.11
fi

limit_args=()
if [[ -n "${EXPORT_LIMIT}" ]]; then
  limit_args=(--limit "${EXPORT_LIMIT}")
fi

uv run --offline --no-sync --project "${REPO_DIR}" \
  python scripts/export_geo_pmw_geotiffs.py \
    --config "${CONFIG_FILE}" \
    --data-root "${TCD_DATA_ROOT}" \
    --manifest-file "${TCD_DATA_ROOT}/index-files/observation_manifest_v5.csv" \
    --output-root "${GEO_PMW_OUTPUT_ROOT}" \
    --splits ${EXPORT_SPLITS} \
    "${limit_args[@]}"
